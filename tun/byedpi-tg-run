#!/bin/sh
# byedpi-tg-run команда [аргументы] — запустить программу в группе byedpi-apps.
# По этой группе режим TUN узнаёт приложение из списка. Пустить его в туннель или мимо,
# решает настройка «Приложения» в карточке TUN (только из списка / все, кроме списка).
# Ярлыки, отмеченные в приложении, уже запускаются через эту команду.
G=byedpi-apps
[ $# -gt 0 ] || { echo "Использование: byedpi-tg-run команда [аргументы]" >&2; exit 2; }
[ "$(id -gn)" = "$G" ] && exec "$@"
if ! id -Gn "$(id -un)" 2>/dev/null | tr ' ' '\n' | grep -qx "$G"; then
    echo "byedpi-tg-run: пользователь не в группе $G (выполни ./install.sh tun). Запускаю без метки." >&2
    exec "$@"
fi
# sg принимает одну строку для sh -c, поэтому каждый аргумент берём в одинарные кавычки
q=""
for a; do
    q="$q '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"
done
exec sg "$G" -c "exec$q"
